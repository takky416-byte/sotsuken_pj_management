{
  "name": "sotsuken-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sotsuken \"vitest run rules-test --no-file-parallelism\"",
    "dev:e2e": "vite --mode e2e --port 5173 --strictPort --host 127.0.0.1",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-sotsuken \"playwright test\"",
    "build:gas": "node scripts/build-gas-report.mjs",
    "check-draft": "vite-node scripts/check-draft.ts",
    "manual": "firebase emulators:exec --only auth,firestore --project demo-sotsuken \"playwright test -c playwright.manual.config.ts\" && node manual/build.mjs && EDITION=teacher node manual/build.mjs && python3 manual/build_pptx.py && EDITION=teacher python3 manual/build_pptx.py"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-admin": "^12.6.0",
    "firebase-tools": "^13.29.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
