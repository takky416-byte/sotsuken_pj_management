rules_version = '2';

// 権限の考え方は docs/design.md の「3. 権限」を参照。
// アクセスできるのは @trident.ac.jp (メール確認済み) かつ roster にあるアカウントだけ。
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() { return request.auth.token.email.lower(); }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@trident[.]ac[.]jp');
    }
    function inRoster() { return signedIn() && exists(/databases/$(database)/documents/roster/$(myEmail())); }
    function me() { return get(/databases/$(database)/documents/roster/$(myEmail())).data; }
    function isTeacher() { return inRoster() && me().role == 'teacher'; }
    function isStudent() { return inRoster() && me().role == 'student'; }
    function inTeam(t) { return isStudent() && me().teamId == t; }
    function canSeeTeam(t) { return isTeacher() || inTeam(t); }
    function actor() { return isTeacher() ? 'teacher' : me().sid; }

    // 日本時間 (UTC+9) の今日を 20261028 の形で返す
    function todayJst() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function isDateOrNull(v) { return v == null || (v is string && v.size() == 10); }

    function validTask(d) {
      return d.keys().hasOnly([
          'title', 'detail', 'parentId', 'depth', 'order', 'status', 'assignees',
          'startDate', 'endDate', 'links', 'source', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt', 'deleted', 'deletedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.detail is string && d.detail.size() <= 5000
        && (d.parentId == null || d.parentId is string)
        && d.depth in [1, 2, 3] // 階層は3つまで (大項目→中項目→小項目)
        && ((d.parentId == null) == (d.depth == 1)) // 最上位だけが、第1階層
        && d.order is number
        && d.status in ['todo', 'doing', 'done', 'hold']
        && d.assignees is list && d.assignees.size() <= 10
        && isDateOrNull(d.startDate) && isDateOrNull(d.endDate)
        && d.links is list && d.links.size() <= 10
        && d.source in ['user', 'draft', 'adhoc']
        && (isTeacher() || d.updatedBy == actor()) // 教員は、バックアップの復元で、元の更新者のまま書ける
        && d.deleted is bool;
    }

    function validTaskLog(d) {
      return d.keys().hasOnly(['taskId', 'title', 'by', 'at', 'kind', 'changes', 'via'])
        && d.taskId is string && d.title is string && d.title.size() <= 200
        && d.by is string && (isTeacher() || d.by == actor())
        && d.at is number
        && d.kind in ['create', 'update', 'delete', 'restore']
        && d.changes is list && d.changes.size() <= 20
        && (!('via' in d.keys()) || (d.via is string && d.via.size() <= 60));
    }

    // 'YYYY-MM-DD' を 20261028 の形にする (dayKey と date の食い違いで、過去の日付に後出しされるのを防ぐ)
    function dateKey(s) { return int(s[0:4]) * 10000 + int(s[5:7]) * 100 + int(s[8:10]); }

    function validDaily(d) {
      return d.keys().hasOnly([
          'sid', 'date', 'dayKey', 'entries', 'blocker', 'next', 'absent', 'submittedAt', 'updatedAt'])
        && d.sid is string && d.date is string && d.date.size() == 10
        && d.dayKey is int
        && d.entries is list && d.entries.size() <= 30
        && d.blocker is string && d.blocker.size() <= 2000
        && (!('next' in d) || (d.next is string && d.next.size() <= 1000))
        && d.absent is bool;
    }

    // ---- 名簿 ----
    match /roster/{email} {
      allow get: if signedIn() && email == myEmail();
      allow read, write: if isTeacher();
    }

    // ---- チーム ----
    match /teams/{teamId} {
      allow read: if canSeeTeam(teamId);
      allow write: if isTeacher();

      match /tasks/{taskId} {
        allow read: if canSeeTeam(teamId);
        allow create: if canSeeTeam(teamId) && validTask(request.resource.data)
          && (isTeacher() || request.resource.data.createdBy == actor());
        allow update: if canSeeTeam(teamId) && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false; // 削除は deleted フラグ (ソフトデリート)
      }

      match /dailyReports/{reportId} {
        allow read: if isTeacher()
          || (inTeam(teamId) && (resource.data.sid == me().sid
              || get(/databases/$(database)/documents/config/settings).data.peerDailyView == true));
        allow create: if isTeacher() && validDaily(request.resource.data)
          || (inTeam(teamId) && validDaily(request.resource.data)
              && request.resource.data.sid == me().sid
              && reportId == request.resource.data.date + '_' + me().sid
              && request.resource.data.dayKey == todayJst()
              && dateKey(request.resource.data.date) == todayJst()
              && request.resource.data.absent == false);
        allow update: if isTeacher() && validDaily(request.resource.data)
          || (inTeam(teamId) && validDaily(request.resource.data)
              && resource.data.sid == me().sid
              && request.resource.data.sid == me().sid
              && resource.data.dayKey == todayJst()
              && request.resource.data.dayKey == resource.data.dayKey
              && resource.data.absent == false
              && request.resource.data.absent == false);
        allow delete: if false;
      }

      match /meetings/{date} {
        allow read: if canSeeTeam(teamId);
        allow write: if isTeacher()
          || (inTeam(teamId) && get(/databases/$(database)/documents/teams/$(teamId)).data.teamMeetingInput == true);
      }

      // ミーティングの要旨。下書き (録音から作る) は先生だけ。公開した要旨は、チームの学生も読める (書けるのは先生だけ)
      match /meetingDrafts/{date} {
        allow read, write: if isTeacher();
      }
      match /meetingSummaries/{date} {
        allow read: if canSeeTeam(teamId);
        allow write: if isTeacher()
          && (request.method == 'delete' || (
            request.resource.data.keys().hasOnly(['date', 'summary', 'decided', 'actions', 'concerns', 'publishedAt'])
            && request.resource.data.summary is string && request.resource.data.summary.size() <= 1200
            && request.resource.data.decided is list && request.resource.data.decided.size() <= 12
            && request.resource.data.actions is list && request.resource.data.actions.size() <= 12
            && request.resource.data.concerns is list && request.resource.data.concerns.size() <= 12));
      }

      // タスクの変更履歴。誰が・いつ・何を変えたかを残す。追加だけできる (書き換え・削除はできない。教員は、バックアップの復元で書ける)
      match /taskLogs/{logId} {
        allow read: if canSeeTeam(teamId);
        allow create: if canSeeTeam(teamId) && validTaskLog(request.resource.data);
        allow update: if isTeacher() && validTaskLog(request.resource.data);
        allow delete: if false;
      }

      // ありがとう (感謝スタンプ)。送った人だけが取り消せる。内容は変えられない
      match /thanks/{thankId} {
        allow read: if canSeeTeam(teamId);
        allow create: if canSeeTeam(teamId)
          && request.resource.data.keys().hasOnly(['from', 'to', 'note', 'date', 'createdAt'])
          && (isTeacher() || request.resource.data.from == actor())
          && request.resource.data.from is string
          && request.resource.data.to is string && request.resource.data.to != request.resource.data.from
          && request.resource.data.note is string && request.resource.data.note.size() <= 100
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && (isTeacher() || dateKey(request.resource.data.date) == todayJst())
          && request.resource.data.createdAt is number;
        allow update: if false;
        allow delete: if isTeacher() || (isStudent() && inTeam(teamId) && resource.data.from == actor());
      }

      match /comments/{commentId} {
        allow read: if canSeeTeam(teamId);
        allow write: if isTeacher();
      }

      match /evaluationsPublished/{docId} {
        allow read: if canSeeTeam(teamId);
        allow write: if isTeacher();
      }
    }

    // ---- 共通設定・マイルストーン ----
    match /config/{docId} {
      allow read: if inRoster();
      allow write: if isTeacher();
    }

    match /milestones/{id} {
      allow read: if isTeacher()
        || (inRoster() && (resource.data.teamId == null || inTeam(resource.data.teamId)));
      allow write: if isTeacher();
    }

    // ---- 教員専用 (学生からは読めない) ----
    match /teacherNotes/{id} { allow read, write: if isTeacher(); }
    match /followups/{id} { allow read, write: if isTeacher(); }

    // アクセス履歴: 学生が自分の今日の分だけ書き (数は増える方向にだけ)、教員だけが読む
    function validAccess(d) {
      return d.keys().hasOnly(['sid', 'teamId', 'date', 'firstAt', 'lastAt', 'visits', 'views', 'screens'])
        && d.sid is string && (d.teamId == null || d.teamId is string)
        && d.date is string && d.date.size() == 10
        && d.firstAt is number && d.lastAt is number && d.lastAt >= d.firstAt
        && d.visits is int && d.visits >= 0 && d.visits <= 1000
        && d.views is int && d.views >= 0 && d.views <= 20000
        && d.screens is map && d.screens.size() <= 20;
    }
    match /accessLogs/{logId} {
      allow read: if isTeacher();
      // 教員は、バックアップの復元で書ける (学生が使っている最中に復元すると、記録の数が食い違うため)
      allow create, update: if isTeacher() && validAccess(request.resource.data);
      allow create: if isStudent() && validAccess(request.resource.data)
        && request.resource.data.sid == me().sid && request.resource.data.teamId == me().teamId
        && logId == request.resource.data.date + '_' + me().sid
        && dateKey(request.resource.data.date) == todayJst();
      allow update: if isStudent() && validAccess(request.resource.data)
        && resource.data.sid == me().sid && request.resource.data.sid == resource.data.sid
        && request.resource.data.date == resource.data.date && dateKey(resource.data.date) == todayJst()
        && request.resource.data.teamId == resource.data.teamId && request.resource.data.firstAt == resource.data.firstAt
        && request.resource.data.lastAt >= resource.data.lastAt
        && request.resource.data.visits >= resource.data.visits && request.resource.data.views >= resource.data.views;
      allow delete: if false;
    }
    match /evaluationsRaw/{id} { allow read, write: if isTeacher(); }
  }
}
